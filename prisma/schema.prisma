generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["synergy"]
}

model User {
  id              Int          @id @default(autoincrement())
  name            String
  email           String       @unique
  emailVerified   Boolean      @default(false) @map("email_verified")
  image           String?
  firstName       String       @map("first_name")
  lastName        String       @map("last_name")
  preferredLocale String       @default("en") @map("preferred_locale")
  role            String       @default("student")
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions        Session[]
  accounts        Account[]
  enrollments     Enrollment[]
  auditEntries    AuditLog[]

  @@map("users")
  @@schema("synergy")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("synergy")
}

model Account {
  id                    Int       @id @default(autoincrement())
  userId                Int       @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
  @@schema("synergy")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
  @@schema("synergy")
}

model Distributor {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  seatBalance Int            @default(0) @map("seat_balance")
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  companies   Organization[]
  enrollments Enrollment[]

  @@map("distributors")
  @@schema("synergy")
}

model Organization {
  id            Int          @id @default(autoincrement())
  name          String       @unique
  distributorId Int?         @map("distributor_id")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  distributor   Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]

  @@index([distributorId])
  @@map("organizations")
  @@schema("synergy")
}

model Course {
  id                     Int            @id @default(autoincrement())
  code                   String         @unique
  certificateValidMonths Int            @default(36) @map("certificate_valid_months")
  passMarkPct            Int            @default(75) @map("pass_mark_pct")
  questionsPerAttempt    Int            @map("questions_per_attempt")
  priceCents             Int            @map("price_cents")
  durationHours          Int            @map("duration_hours")
  lectureMinutes         Int            @map("lecture_minutes")
  timeLimitMinutes       Int            @default(120) @map("time_limit_minutes")
  maxAttempts            Int?           @default(3) @map("max_attempts")
  shuffleQuestions       Boolean        @default(true) @map("shuffle_questions")
  shuffleAnswers         Boolean        @default(true) @map("shuffle_answers")
  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  locales                CourseLocale[]

  @@map("courses")
  @@schema("synergy")
}

model CourseLocale {
  courseId        Int          @map("course_id")
  locale          String
  name            String
  description     String?
  lectureTitle    String       @map("lecture_title")
  outcomes        String[]
  materialFileKey String?      @map("material_file_key")
  certificateCode String       @map("certificate_code")
  course          Course       @relation(fields: [courseId], references: [id])
  enrollments     Enrollment[]
  questions       Question[]

  @@id([courseId, locale])
  @@map("course_locales")
  @@schema("synergy")
}

model Enrollment {
  id                  Int           @id @default(autoincrement())
  userId              Int           @map("user_id")
  courseId            Int           @map("course_id")
  locale              String
  organizationId      Int?          @map("organization_id")
  seatDistributorId   Int?          @map("seat_distributor_id")
  paid                Boolean       @default(false)
  passedOn            DateTime?     @map("passed_on") @db.Date
  certificateNumber   String?       @unique @map("certificate_number")
  certificateIssuedAt DateTime?     @map("certificate_issued_at") @db.Timestamptz(6)
  attemptsResetAt     DateTime?     @map("attempts_reset_at") @db.Timestamptz(6)
  notes               String?
  legacyUserId        Int?          @unique @map("legacy_user_id")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseLocale        CourseLocale  @relation(fields: [courseId, locale], references: [courseId, locale])
  organization        Organization? @relation(fields: [organizationId], references: [id])
  seatDistributor     Distributor?  @relation(fields: [seatDistributorId], references: [id], onDelete: SetNull)
  attempts            Attempt[]

  @@index([userId])
  @@index([organizationId])
  @@index([seatDistributorId])
  @@map("enrollments")
  @@schema("synergy")
}

model Question {
  id           Int             @id @default(autoincrement())
  courseId     Int             @map("course_id")
  locale       String
  type         String          @default("multipleChoice")
  prompt       String
  options      String[]
  correctIndex Int             @map("correct_index")
  explanation  String?
  sortOrder    Int             @default(0) @map("sort_order")
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  courseLocale CourseLocale    @relation(fields: [courseId, locale], references: [courseId, locale])
  answers      AttemptAnswer[]

  @@index([courseId, locale])
  @@map("questions")
  @@schema("synergy")
}

model Attempt {
  id            Int             @id @default(autoincrement())
  enrollmentId  Int             @map("enrollment_id")
  startedAt     DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(6)
  submittedAt   DateTime?       @map("submitted_at") @db.Timestamptz(6)
  passMarkPct   Int             @map("pass_mark_pct")
  questionCount Int             @map("question_count")
  correctCount  Int?            @map("correct_count")
  passed        Boolean?
  enrollment    Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  answers       AttemptAnswer[]

  @@index([enrollmentId])
  @@map("attempts")
  @@schema("synergy")
}

model AttemptAnswer {
  id                Int       @id @default(autoincrement())
  attemptId         Int       @map("attempt_id")
  questionId        Int?      @map("question_id")
  sortOrder         Int       @default(0) @map("sort_order")
  questionText      String    @map("question_text")
  options           String[]
  selectedIndex     Int?      @map("selected_index")
  answerText        String?   @map("answer_text")
  correctAnswerText String?   @map("correct_answer_text")
  isCorrect         Boolean   @default(false) @map("is_correct")
  attempt           Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@map("attempt_answers")
  @@schema("synergy")
}

model Review {
  id          Int      @id @default(autoincrement())
  locale      String
  author      String
  roleCompany String?  @map("role_company")
  body        String
  rating      Int?
  photoKey    String?  @map("photo_key")
  published   Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("reviews")
  @@schema("synergy")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  adminId     Int?     @map("admin_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  entityLabel String   @map("entity_label")
  details     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  admin       User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([adminId])
  @@map("audit_log")
  @@schema("synergy")
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start") @db.Timestamptz(6)

  @@index([windowStart])
  @@map("rate_limit_buckets")
  @@schema("synergy")
}
