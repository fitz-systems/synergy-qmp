# Copy to .env.local and fill in. Never commit real values.

# Postgres connection used by the app at runtime (pooled URL if your host gives you one).
DATABASE_URL=""

# Optional: direct (non-pooled) URL for Prisma migrations. Falls back to DATABASE_URL.
DIRECT_URL=""

# Better Auth. Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Resend (Vercel Marketplace). EMAIL_FROM must use a domain verified in Resend, e.g. "Synergy QMP <no-reply@send.synergyqmp.com>".
# Without these, emails are printed to the console in development and sending fails in production.
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional: send contact form messages here instead of info@synergyqmp.com (use your own address while testing).
CONTACT_EMAIL_TO=""

# Vercel Blob (private store for course material PDFs). `vercel env pull` fills these in.
# Either BLOB_READ_WRITE_TOKEN, or BLOB_STORE_ID together with the VERCEL_OIDC_TOKEN that `vercel env pull` also writes.
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
